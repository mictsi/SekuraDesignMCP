# Sekura Design System — container settings.
#
#   cp .env.example .env      then edit .env, which is gitignored.
#
# Everything the container reads is here. `docker compose up`, `./run.sh start`
# and `docker run --env-file .env` all take their configuration from this one
# file, so there is a single place to look when a deployment misbehaves.
#
# `npm run check:env` fails the build if the code reads a variable this file
# does not document, or documents one nothing reads.


# ─────────────────────────────────────────────────────────────────────────────
# Transport
# ─────────────────────────────────────────────────────────────────────────────

# http  — streamable HTTP, for the container. Any number of clients, one server.
# stdio — the client spawns the process and talks over its pipes. Local use.
SEKURA_MCP_TRANSPORT=http

# Inside the container. Leave at 8080 and remap on the host with SEKURA_PORT —
# changing this one instead means the healthcheck and the port mapping disagree.
PORT=8080

# 0.0.0.0 so the port is reachable from outside the container. 127.0.0.1 would
# bind to the container's own loopback and nothing could connect.
HOST=0.0.0.0

# Older alias for PORT, still honoured as a fallback. Set PORT instead; this
# exists so an existing deployment that used it does not break on upgrade.
SEKURA_MCP_PORT=8080


# ─────────────────────────────────────────────────────────────────────────────
# Where this is published
#
# The MCP endpoint, the health check, the documentation site and every artefact
# are served from ONE port under ONE path prefix:
#
#   http://host:8080/<app_path>/mcp        MCP, POST
#   http://host:8080/<app_path>/health     health
#   http://host:8080/<app_path>/docs/      documentation site
#   http://host:8080/<app_path>/manifest.json
#   http://host:8080/<app_path>/css/sekura.css
#   http://host:8080/<app_path>/js/sekura.iife.min.js
#   http://host:8080/<app_path>/tokens.css
#   http://host:8080/<app_path>/tokens.json
#
# The two variables below answer two different questions. They are equal in the
# simple case and different in the common one, which is why there are two.
# ─────────────────────────────────────────────────────────────────────────────

# WHERE DOES THIS PROCESS LISTEN?
#
# Set it when the proxy passes the prefix through:
#
#   location /design-system/ { proxy_pass http://app:8080/design-system/; }
#   SEKURA_BASE_PATH=/design-system
#
# `/` serves everything at the root.
SEKURA_BASE_PATH=/

# WHAT DOES THE OUTSIDE WORLD SEE?
#
# The public base URL that generated links are built from. Set it when the proxy
# STRIPS the prefix — the app keeps listening at the root, but has no way to
# discover what was removed, so it must be told:
#
#   location /design-system/ { proxy_pass http://app:8080/; }
#   SEKURA_EXTERNAL_URL=https://example.com/design-system
#
# Leave empty and links are derived per request from X-Forwarded-Proto,
# X-Forwarded-Host and X-Forwarded-Prefix. Traefik and ingress-nginx send those,
# so with either of them neither variable is needed.
SEKURA_EXTERNAL_URL=

# The MCP endpoint, relative to SEKURA_BASE_PATH. Rename it if /mcp collides
# with something already at that path on your host.
SEKURA_MCP_PATH=/mcp

# Honour X-Forwarded-* headers. Set false when the container is exposed directly
# to the internet, so a forged X-Forwarded-Host cannot make the server hand out
# links pointing at somebody else's domain.
SEKURA_TRUST_PROXY=true


# ─────────────────────────────────────────────────────────────────────────────
# Host side — used by docker-compose and ./run.sh, not by the server itself
# ─────────────────────────────────────────────────────────────────────────────

# Host port mapped to the container's PORT.
SEKURA_PORT=8080

# Image tag. Defaults to the version in package.json.
SEKURA_VERSION=1.0.0

# Image name and container name.
SEKURA_IMAGE=sekura-design-mcp
SEKURA_CONTAINER=sekura-design-mcp

# Port for `./run.sh docs`, a standalone documentation server used only when
# iterating on the site itself. `./run.sh start` does not use it — the server
# publishes /docs on its own port.
SAMPLE_PORT=4173


# ─────────────────────────────────────────────────────────────────────────────
# Node
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
