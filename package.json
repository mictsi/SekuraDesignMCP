{
  "name": "sekura-design-mcp",
  "version": "2.1.0",
  "description": "Sekura Design System \u2014 MCP server exposing the complete design, UX, accessibility and dark-mode specification as machine-readable tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sekura-design-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "SEKURA_MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "audit:contrast": "node dist/scripts/audit-contrast.js",
    "lint:css": "node dist/scripts/lint-css.js",
    "emit:css": "node dist/scripts/emit-css.js",
    "smoke": "node dist/scripts/smoke.js",
    "test:errors": "node dist/scripts/test-errors.js",
    "verify": "npm run build && npm run check:version && npm run check:deps && npm run check:env && npm run test:color && npm run test:urls && npm run audit:contrast && npm run lint:css && npm run smoke && npm run test:errors && npm run test:integration && npm run test:request && npm run build:behaviours && npm run test:codegen && npm run test:blazor && npm run test:behaviours && npm run emit:css && npm run site:build && npm run verify:sample && npm run site:publish && npm run test:rtl && npm run test:announce && npm run build:design-kit && npm run build:react && npm run test:browsers && npm run test:design && npm run test:a11y",
    "verify:sample": "node dist/scripts/verify-sample.js",
    "site:build": "node dist/scripts/build-site.js",
    "site:publish": "npm run site:build && node dist/scripts/publish-site.js",
    "build:behaviours": "tsc -p tsconfig.behaviours.json && node dist/scripts/build-behaviours.js",
    "test:behaviours": "node dist/scripts/test-behaviours.js",
    "check:version": "node dist/scripts/check-version.js",
    "check:deps": "node dist/scripts/check-deps.js",
    "check:env": "node dist/scripts/check-env.js",
    "test:a11y": "node src/scripts/test-a11y.mjs",
    "test:announce": "node src/scripts/test-announce.mjs",
    "test:color": "node dist/scripts/test-color.js",
    "test:urls": "node dist/scripts/test-urls.js",
    "test:rtl": "node dist/scripts/test-rtl.js",
    "test:codegen": "node dist/scripts/test-codegen.js",
    "test:design": "node src/scripts/test-design.mjs",
    "test:blazor": "node dist/scripts/test-blazor.js",
    "build:react": "tsc -p tsconfig.react.json && node src/scripts/build-react.mjs",
    "test:integration": "node dist/scripts/test-integration.js",
    "test:browsers": "node src/scripts/test-browsers.mjs",
    "demo:server": "node src/scripts/demo-server.mjs",
    "build:design-kit": "tsc -p tsconfig.figma.json && node src/scripts/build-design-kit.mjs",
    "test:request": "node src/scripts/test-request.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "design-tokens",
    "accessibility",
    "dark-mode",
    "sekura"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "parse5": "^8.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@figma/plugin-typings": "^1.138.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vue/compiler-sfc": "^3.5.42",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.42"
  },
  "files": [
    "dist",
    "dist-css",
    "dist-js",
    "DESIGN.md",
    "DESIGN-AUDIT.md",
    "DESIGN-REVIEW.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist-react",
    "dist-design-kit",
    "MANUAL-VALIDATION.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mictsi/SekuraDesignMCP.git"
  }
}
